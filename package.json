{
	"name": "cis-to-fleet",
	"version": "0.1.0",
	"description": "Convert CIS benchmarks to Fleet-compatible policy files",
	"type": "module",
	"bin": {
		"cis-to-fleet": "./dist/cli.js"
	},
	"scripts": {
		"dev": "bun run src/cli.ts",
		"dev:node": "npx tsx src/cli.ts",
		"build": "bun build src/cli.ts --outdir dist --target node",
		"build:node": "tsc",
		"test": "bun test",
		"test:node": "npx jest",
		"lint": "bunx @biomejs/biome check .",
		"lint:fix": "bunx @biomejs/biome check --apply ."
	},
	"keywords": ["cis", "fleet", "security", "compliance", "benchmark"],
	"license": "MIT",
	"dependencies": {
		"chalk": "^5.3.0",
		"commander": "^12.0.0",
		"ora": "^8.0.0",
		"yaml": "^2.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.8.0",
		"@types/bun": "latest",
		"@types/node": "^24.1.0",
		"tsx": "^4.7.0",
		"typescript": "^5.9.2"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"engines": {
		"node": ">=18.0.0"
	}
}
